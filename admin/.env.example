# Leave unset in development: Vite proxies /api to http://localhost:4000.
# Set to the full API URL for production builds, e.g. https://api.example.com/api
VITE_API_URL=
# Neon Realtime WebSocket URL (NEON_REALTIME_URL from the repo-root .env.local). Leave unset to disable live bookings.
VITE_NEON_REALTIME_URL=
